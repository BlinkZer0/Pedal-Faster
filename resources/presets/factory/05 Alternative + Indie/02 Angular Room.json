    "enabled": true,
    "parameters": {
      "gain": 0.4,
      "bass": 0.4,
      "mid": 0.5,
      "treble": 0.65,
      "presence": 0.6,
      "master": 0.45,
      "sag": 0.3,
      "trimDb": 0.0
    }
  },
