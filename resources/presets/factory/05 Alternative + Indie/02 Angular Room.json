{
  "schemaVersion": 1,
  "id": "factory.indie.angular-room",
  "name": "Angular Room",
  "category": "Alternative & Indie",
  "description": "Spiky, bright crunch in a small room.",
  "author": "Pedal Faster",
  "tags": [
    "indie",
    "angular",
    "crunch",
    "bright"
  ],
  "gainLevel": 4,
