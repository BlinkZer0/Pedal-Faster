{
  "schemaVersion": 1,
  "id": "factory.psych.bitdust",
  "name": "Bitdust",
  "category": "Psychedelic & Experimental",
  "description": "Dusty 4-bit crunch with vibrato.",
  "author": "Pedal Faster",
  "tags": [
    "experimental",
    "bitcrusher",
    "lo-fi"
  ],
  "gainLevel": 2,
  "inputGainDb": 0.0,
  "gate": {
    "enabled": false,
    "thresholdDb": -60.0,
    "releaseMs": 80.0
  },
  "amp": {
    "type": "class_a_chime",
    "enabled": true,
    "parameters": {
      "gain": 0.35,
      "bass": 0.5,
      "mid": 0.5,
      "treble": 0.5,
      "presence": 0.45,
      "master": 0.45,
      "sag": 0.3,
      "trimDb": 0.0
    }
  },
  "cabinet": {
    "type": "open_1x12",
    "enabled": true,
    "mic": 0.5,
    "lowCutHz": 70.0,
    "highCutHz": 9000.0,
    "levelDb": 0.0,
    "mix": 1.0
  },
  "effects": [
    {
      "slotId": "slot-1",
      "type": "bitcrusher",
      "position": "pre",
      "enabled": true,
      "mix": 0.45,
      "parameters": {
        "bits": 4.0,
        "downsample": 10.0,
        "tone": 0.4,
        "outputDb": 0.0
      }
    },
    {
      "slotId": "slot-2",
      "type": "vibrato",
      "position": "post",
      "enabled": true,
      "mix": 0.5,
      "parameters": {
        "rateHz": 3.0,
        "depth": 0.3,
        "shape": 1.0
      }
    },
    {
      "slotId": "slot-3",
      "type": "plate_reverb",
      "position": "post",
      "enabled": true,
      "mix": 0.2,
      "parameters": {
        "decay": 2.5,
        "predelayMs": 10.0,
        "damping": 0.4,
        "lowCutHz": 120.0,
        "modulation": 0.5
      }
    }
  ],
  "masterEq": {
    "enabled": true,
    "lowDb": 0.0,
    "midDb": 0.0,
    "midFreqHz": 800.0,
    "highDb": 0.0
  },
  "limiter": {
    "enabled": true,
    "ceilingDb": -0.5
  },
  "macros": [],
  "outputGainDb": 0.38
}